universe liquid_selected {
  from universe.selected
  require liquidity {
    avg_turnover(20) >= 1_000_000
    median_turnover(20) >= 500_000
    active_sessions(20) >= 20
  }
}

strategy ha_breakout_struct {
  source universe.liquid_selected
  candles timeframe "1d" as heikin_ashi
  scan within 5 candles


  candle setup {
    when =>
      ema("low", 20).within_body
      &&  ema("high", 20).not_within_body
      && is_green
  }


  candle breakout {
    when =>
      ema("high", 20).within_body
      && ema("low", 20).not_within_body
      && is_green
      && rsi(14) > 50
      && ema("close", 200).slope > 0
      && rsi(14).slope > 0
      && atr(14) / close >= 0.01
      && volume > volume_ema(20) * 1.2
  }

  candle breakdown {
    when => close < ema("low", 20)
  }

  entrystruct {
    setup
    breakout
    at breakout.close
  }

  exitstruct {
    breakdown
  }
}

let matches = ha_breakout_struct.run()
matches.show()
