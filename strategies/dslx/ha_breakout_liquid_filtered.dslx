universe liquid_selected {
  from universe.selected
  require liquidity {
    avg_turnover(20) >= 1_000_000
    median_turnover(20) >= 500_000
    active_sessions(20) >= 20
  }
}

strategy ha_breakout {
  source universe.liquid_selected
  candles timeframe "1d" as heikin_ashi
  scan latest

  entry when candle =>
    candle.open > candle.ema("low", 20)
    && candle.ema("high", 20).within_body
    && candle.is_green
    && candle.rsi(14) > 50
    && candle.ema("close", 200).slope > 0
    && candle.rsi(14).slope > 0
    && candle.volume > candle.volume_ema(20) * 1.5

  exit when candle => candle.close < candle.ema("low", 20)
}

let matches = ha_breakout.run()
matches.show()
