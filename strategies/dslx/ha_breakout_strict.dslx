universe strict_liquid_selected {
  from universe.selected
  require liquidity {
    avg_turnover(20) >= 5_000_000
    median_turnover(20) >= 2_000_000
    active_sessions(20) >= 20
  }
}

strategy ha_breakout_strict {
  source universe.strict_liquid_selected
  candles timeframe "1d" as heikin_ashi
  scan latest

  candle setup {
    when =>
      (
        ema("low", 20).lower_wick_intersects
          || ema("low", 20).body_intersects
      )
      && is_green
  }

  candle breakout {
    when =>
      ema("high", 20).body_intersects
      && is_green
      && rsi(14) > 55
      && ema("close", 200).slope > 0
      && rsi(14).slope > 0
      && atr(14) / close >= 0.012
      && volume > volume_ema(20) * 1.5
  }

  candle breakdown {
    when => close < ema("low", 20)
  }

  entrystruct {
    setup
    breakout
    at breakout.close
  }

  exitstruct {
    breakdown
  }
}

let matches = ha_breakout_strict.run()
matches.show()
